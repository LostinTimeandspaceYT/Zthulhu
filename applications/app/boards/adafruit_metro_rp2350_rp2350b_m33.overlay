#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350b-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/clock/rpi_pico_clock_common.h>

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	/* LVGL encoder input pseudo-device */
	lvgl_encoder: lvgl_encoder {
		compatible = "zephyr,lvgl-encoder-input";
		rotation-input-code = <INPUT_REL_Y>;
		button-input-code = <INPUT_KEY_0>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&pinctrl {
	pio0_spi0_arduino_default: pio0_spi0_arduino_default {
		group1 {
			/* ICSP SPI1: SCK=GPIO30, MOSI=GPIO31, MISO=GPIO27 */
			pinmux = <PIO0_P30>, <PIO0_P31>, <PIO0_P27>;
		};
	};

	/* Metro RP2350 onboard SD card slot - hardware SPI0 */
	spi0_sd_default: spi0_sd_default {
		group1 {
			pinmux = <SPI0_SCK_P34>, <SPI0_TX_P35>;
		};
		group2 {
			pinmux = <SPI0_RX_P36>;
			input-enable;
		};
	};
};

&arduino_spi {
	clk-gpios = <&gpio0 30 0>;
	mosi-gpios = <&gpio0 31 0>;
	miso-gpios = <&gpio0 27 0>;
	pinctrl-0 = <&pio0_spi0_arduino_default>;
	pinctrl-names = "default";
};

/* Enable gpio0_hi for GPIOs 32-47 (used by onboard SD card) */
&gpio0_hi {
	status = "okay";
};

/* STEMMA QT I2C - GPIO20 (SDA) and GPIO21 (SCL) */
/* FIXME: CHANGE TO USE ARDUINO I2C */
&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	seesaw: seesaw@36 {
		compatible = "adafruit,seesaw-encoder";
		reg = <0x36>;
		seesaw-product-id = <4991>;
		encoder-pin = <24>;
		poll-interval-ms = <10>;
		/* Disabled while debugging SD card */
		status = "disabled";
	};
};

/* Metro RP2350 onboard SD card slot - hardware SPI0 */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_sd_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0_hi 7 GPIO_ACTIVE_LOW>;  /* GPIO 39 = 32 + 7 */

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <400000>;
		power-delay-ms = <100>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD0";
			status = "okay";
		};
	};
};
